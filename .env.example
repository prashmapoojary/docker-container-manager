# =================================================================
# Docker Container Manager - Environment Configuration
# =================================================================

# Port Configuration
# Change PORT to 3000 if running locally alongside other port 80 services
PORT=80
BACKEND_PORT=5000
GRAFANA_PORT=3001

# Dashboard Authentication Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123
JWT_SECRET=replace_with_a_long_random_secure_secret_key

# Core System Containers (Comma-separated list protected from stop/deletion)
PROTECTED_CONTAINERS=portainer-backend,portainer-frontend,cadvisor,prometheus,grafana
